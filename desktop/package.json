{
  "name": "tvlibre",
  "productName": "TV Libre",
  "version": "1.0.0",
  "description": "Lecteur IPTV de chaînes publiques gratuites",
  "author": "developersanoussy",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "web": "node -e \"require('fs').cpSync('../app/src/main/assets','web',{recursive:true})\"",
    "start": "npm run web && electron .",
    "dist": "npm run web && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.naokane.tvlibre",
    "productName": "TV Libre",
    "files": ["main.js", "web/**/*"],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "TVLibre-Setup-${version}.${ext}"
    },
    "portable": { "artifactName": "TVLibre-Portable-${version}.${ext}" },
    "linux": { "target": "AppImage", "category": "Video", "icon": "build/icon.png", "artifactName": "TVLibre-${version}.${ext}" },
    "mac": { "target": "dmg", "icon": "build/icon.png", "artifactName": "TVLibre-${version}-mac.${ext}" }
  }
}
